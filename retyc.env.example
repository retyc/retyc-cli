# retyc — full example of an environment file, every setting at its default value.
#
# Use it with `retyc --env-file /etc/retyc/env <command>` or RETYC_ENV_FILE=/etc/retyc/env
# (boot mounts, systemd, CSI, containers). Reference: doc/configuration.md.
#
# Rules:
#   - the file must be mode 0600 on Linux and macOS, or the command refuses to start
#   - one NAME=value per line; `export NAME=value` is accepted; `#` starts a comment line
#   - only RETYC_* names (RETYC_ENV_FILE itself excluded); HTTPS_PROXY, SSL_CERT_FILE... are errors
#   - nothing is expanded ($HOME stays $HOME); use quotes for leading/trailing spaces
#   - a variable already in the real environment wins over this file
#   - an empty value counts as unset: comment out what you do not change
#
# Every line below is commented out: uncomment and edit only what you need.
# Each RETYC_A_B matches the config.yaml key a.b (see config.example.yaml).

# --- Secrets (environment / env file only, never in config.yaml) ---------------

# Offline token, from `retyc auth login --offline`. Default: the stored login.
#RETYC_TOKEN=
# Passphrase of your key. Default: prompted.
#RETYC_KEY_PASSPHRASE=
# Password of `retyc fs webdav serve`. Default: generated at startup.
#RETYC_WEBDAV_PASSWORD=

# --- Location ------------------------------------------------------------------

# Config directory (config.yaml and token.json). Default: ~/.config/retyc/
#RETYC_CONFIG_DIR=/home/retyc/.config/retyc

# --- API -----------------------------------------------------------------------

# Dev build (no -tags prod): https://api.triplesfer.traefik.me
#RETYC_API_BASE_URL=https://api.retyc.com
#RETYC_API_UNSAFE_WRITE=false
# Parallel requests, 1 to 32
#RETYC_API_CONCURRENCY_LIST=4
#RETYC_API_CONCURRENCY_UPLOAD=4
#RETYC_API_CONCURRENCY_DOWNLOAD=4
# Rate limit (429): 1s to 10m, and 1 to 100
#RETYC_API_RETRY_MAX_WAIT=30s
#RETYC_API_RETRY_MAX_ATTEMPTS=10

# --- Key cache (Linux) ---------------------------------------------------------

#RETYC_KEYRING_ENABLED=true
# seconds
#RETYC_KEYRING_TTL=60

# --- Organization (retyc admin) ------------------------------------------------

# Default: <api base URL>/v1
#RETYC_ADMIN_BASE_URL=
#RETYC_ADMIN_API_KEY=
#RETYC_ADMIN_PRIVATE_KEY_FILE=

# --- Metadata cache of retycfs -------------------------------------------------

#RETYC_CACHE_TTL=1m
#RETYC_CACHE_MAX_STALE=5m
#RETYC_CACHE_NEGATIVE_TTL=1s
# memory | redis
#RETYC_CACHE_STORE=memory
# Required with redis; the URL carries the password
#RETYC_CACHE_REDIS_URL=
#RETYC_CACHE_REDIS_HIGH_CONFIDENTIALITY=false

# --- WebDAV (retyc fs webdav serve) --------------------------------------------

#RETYC_WEBDAV_ADDR=127.0.0.1:8888

# --- retycfs (retyc fs mount, Linux) -------------------------------------------

# 0: follows RETYC_CACHE_TTL
#RETYC_MOUNT_ENTRY_TTL=0s
#RETYC_MOUNT_ATTR_TTL=0s
#RETYC_MOUNT_KERNEL_CACHE=true
#RETYC_MOUNT_READDIR_PLUS=false
# Default: the system's temporary directory
#RETYC_MOUNT_SPOOL_DIR=
#RETYC_MOUNT_ALLOW_OTHER=false
# -1: the user / group running the command
#RETYC_MOUNT_UID=-1
#RETYC_MOUNT_GID=-1
#RETYC_MOUNT_FILE_MODE=0644
#RETYC_MOUNT_DIR_MODE=0755
#RETYC_MOUNT_READ_ONLY=false
# 0: do not wait for the files being sent
#RETYC_MOUNT_DRAIN_TIMEOUT=5m
#RETYC_MOUNT_MIRROR_LOCKS=false
#RETYC_MOUNT_BACKGROUND_DELETE=false
# Glob patterns separated by spaces; `none`: no pattern
#RETYC_MOUNT_LOCAL_FILES=.*.swp .*.swx *~ 4913
# Metrics and probes listener, e.g. 127.0.0.1:9100. Default: disabled
#RETYC_MOUNT_METRICS_ADDR=
# key=value pairs separated by spaces
#RETYC_MOUNT_METRICS_LABELS=

# --- Dev builds only (go build . without -tags prod) ---------------------------

# Skip TLS certificate verification
#RETYC_INSECURE=false
